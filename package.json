{
  "name": "chalsense-workspace",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/widget"
  ],
  "scripts": {
    "build:widget": "npm run build --workspace @chalsense/widget",
    "demo:widget": "npm run build:widget && node packages/widget/scripts/serve-demo.mjs --open",
    "test:widget": "npm run test --workspace @chalsense/widget",
    "test:widget:browser": "npm run test:browser --workspace @chalsense/widget",
    "test:calibration": "node --test tools/calibration/tests/*.test.mjs",
    "verify:widget": "npm run build:widget && npm run test:widget && npm run test:widget:browser && npm run test:calibration"
  }
}
