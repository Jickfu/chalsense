# Review and adapt before production use. This example assumes Nginx and ChalSense share a host.
limit_req_zone $binary_remote_addr zone=chalsense_public:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=chalsense_connections:10m;

upstream chalsense_server {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 443 ssl;
    server_name verify.example.com;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private-key.pem;

    client_max_body_size 64k;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 15s;

    location /v1/public/ {
        limit_req zone=chalsense_public burst=20 nodelay;
        limit_conn chalsense_connections 20;

        proxy_pass http://chalsense_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
        proxy_request_buffering on;
        proxy_buffering on;
    }

    # Keep the trusted API on a separate private listener/network in real deployments.
    location /v1/trusted/ {
        allow 127.0.0.1;
        allow ::1;
        deny all;

        proxy_pass http://chalsense_server;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
    }

    location = /livez {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://chalsense_server;
    }

    location = /readyz {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://chalsense_server;
    }
}
